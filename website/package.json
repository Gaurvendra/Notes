{
  "name": "java-mastery-track",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Java Mastery Track: learn Java from scratch to expert, built from verified notes.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:stubs": "node scripts/sync-stubs.mjs",
    "check:stubs": "node scripts/sync-stubs.mjs --check",
    "check:types": "astro check",
    "check:links": "node scripts/check-links.mjs",
		"check:floatlab": "node scripts/check-float-lib.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "npm run check:stubs && npm run check:floatlab && npm run check:types && npm run build && npm run check:links"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/starlight": "^0.42.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "astro-mermaid": "^2.1.0",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "mermaid": "^11.17.2",
    "preact": "^10.29.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "playwright": "^1.56.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
