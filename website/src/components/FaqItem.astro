---
/** One "Doubts cleared" entry: a question that expands to its answer. <FaqItem q="Is the JVM…?">Answer…</FaqItem> */
import { mdInline } from '../lib/markdown.mjs';

interface Props {
	q: string;
}
const { q } = Astro.props;
---

<details class="jmt-faq">
	<summary set:html={mdInline(q)} />
	<div class="jmt-faq__answer"><slot /></div>
</details>
