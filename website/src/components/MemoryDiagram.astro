---
/**
 * Stack & heap diagram rendered as inline SVG at build time (no JS, works in light and dark themes).
 *
 * <MemoryDiagram
 *   caption="After `Person p = new Person(\"Ann\")`"
 *   frames={[{ name: 'main()', vars: [{ name: 'p', ref: 'p1' }, { name: 'n', value: '10' }] }]}
 *   heap={[
 *     { id: 'p1', label: 'Person', fields: [{ name: 'name', ref: 's1' }] },
 *     { id: 's1', label: '"Ann"', pool: true },
 *   ]}
 * />
 * Frames are listed top of stack first. Flags: frame.gone (popped), object.gc (unreachable), *.highlight.
 */
interface Var {
	name: string;
	value?: string;
	ref?: string;
	type?: string;
	highlight?: boolean;
}
interface Frame {
	name: string;
	vars: Var[];
	gone?: boolean;
	highlight?: boolean;
}
interface HeapObject {
	id: string;
	label: string;
	fields?: Var[];
	pool?: boolean;
	gc?: boolean;
	highlight?: boolean;
}
interface Props {
	frames: Frame[];
	heap?: HeapObject[];
	caption?: string;
	stackTitle?: string;
	heapTitle?: string;
}
const { frames, heap = [], caption, stackTitle = 'Stack', heapTitle = 'Heap' } = Astro.props;

const PAD = 16, TITLE = 28, STACK_W = 240, GAP = 110, HEAP_W = 250, RIGHT = 60;
const FRAME_HEAD = 28, ROW = 24, OBJ_HEAD = 28, OBJ_ROW = 22, V_GAP = 14;
const stackX = PAD;
const heapX = PAD + STACK_W + GAP;

// Stack layout
let y = PAD + TITLE;
const frameBoxes = frames.map((f) => {
	const h = FRAME_HEAD + Math.max(1, f.vars.length) * ROW + 8;
	const box = { ...f, x: stackX, y, w: STACK_W, h };
	y += h + V_GAP;
	return box;
});
const stackBottom = y;

// Heap layout: regular objects first, then the String Constant Pool region
const regular = heap.filter((o) => !o.pool);
const pooled = heap.filter((o) => o.pool);
const objectHeight = (o: HeapObject) => (o.fields?.length ? OBJ_HEAD + o.fields.length * OBJ_ROW + 6 : OBJ_HEAD + 6);
let hy = PAD + TITLE;
const objBoxes = new Map<string, HeapObject & { x: number; y: number; w: number; h: number }>();
for (const o of regular) {
	const h = objectHeight(o);
	objBoxes.set(o.id, { ...o, x: heapX, y: hy, w: HEAP_W, h });
	hy += h + V_GAP;
}
let pool: { x: number; y: number; w: number; h: number } | undefined;
if (pooled.length) {
	const poolTop = hy + 6;
	let py = poolTop + 30;
	for (const o of pooled) {
		const h = objectHeight(o);
		objBoxes.set(o.id, { ...o, x: heapX + 14, y: py, w: HEAP_W - 28, h });
		py += h + 10;
	}
	pool = { x: heapX, y: poolTop, w: HEAP_W, h: py - poolTop + 4 };
	hy = py + 14;
}
const width = heapX + HEAP_W + RIGHT;
const height = Math.max(stackBottom, hy) + PAD - V_GAP + 4;

// Arrows
type Arrow = { d: string; gc: boolean };
const arrows: Arrow[] = [];
const missing: string[] = [];
frameBoxes.forEach((f) =>
	f.vars.forEach((v, i) => {
		if (!v.ref) return;
		const target = objBoxes.get(v.ref);
		if (!target) return missing.push(v.ref);
		const x1 = f.x + f.w - 8, y1 = f.y + FRAME_HEAD + i * ROW + ROW / 2;
		const x2 = target.x, y2 = target.y + OBJ_HEAD / 2;
		const mx = (x1 + x2) / 2;
		arrows.push({ d: `M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2 - 2},${y2}`, gc: !!(f.gone || target.gc) });
	}),
);
[...objBoxes.values()].forEach((o) =>
	(o.fields ?? []).forEach((fd, i) => {
		if (!fd.ref) return;
		const target = objBoxes.get(fd.ref);
		if (!target) return missing.push(fd.ref);
		const x1 = o.x + o.w, y1 = o.y + OBJ_HEAD + i * OBJ_ROW + OBJ_ROW / 2;
		const x2 = target.x + target.w, y2 = target.y + OBJ_HEAD / 2;
		const bulge = Math.max(x1, x2) + 44;
		arrows.push({ d: `M${x1 - 6},${y1} C${bulge},${y1} ${bulge},${y2} ${x2 + 2},${y2}`, gc: !!(o.gc || target.gc) });
	}),
);
if (missing.length) throw new Error(`MemoryDiagram: unknown ref(s) ${missing.join(', ')}`);
const label = caption ?? 'Memory diagram: stack frames on the left, heap objects on the right';
// Deterministic id (stable builds): hash of the diagram's content
const hash = [...JSON.stringify({ frames, heap, caption })].reduce((h, c) => (Math.imul(31, h) + c.charCodeAt(0)) | 0, 7);
const markerId = `jmt-arrow-${(hash >>> 0).toString(36)}`;
---

<figure class="jmt-memory">
	<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label} preserveAspectRatio="xMinYMin meet">
		<defs>
			<marker id={markerId} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0,0 L10,5 L0,10 z" class="jmt-mem-arrowhead" />
			</marker>
		</defs>
		<text x={stackX} y={PAD + 14} class="jmt-mem-title">{stackTitle}</text>
		<text x={heapX} y={PAD + 14} class="jmt-mem-title">{heapTitle}</text>
		{frameBoxes.map((f) => (
			<g class={`jmt-mem-frame ${f.gone ? 'is-gone' : ''} ${f.highlight ? 'is-hl' : ''}`}>
				<rect x={f.x} y={f.y} width={f.w} height={f.h} rx="8" class="jmt-mem-box" />
				<text x={f.x + 10} y={f.y + 19} class="jmt-mem-head">{f.name}{f.gone ? '  (popped)' : ''}</text>
				{f.vars.length === 0 && <text x={f.x + 12} y={f.y + FRAME_HEAD + 16} class="jmt-mem-muted">no locals</text>}
				{f.vars.map((v, i) => (
					<g class={v.highlight ? 'is-hl' : ''}>
						<text x={f.x + 12} y={f.y + FRAME_HEAD + i * ROW + 16} class="jmt-mem-name">{v.type ? `${v.type} ` : ''}{v.name}</text>
						<text x={f.x + f.w - 14} y={f.y + FRAME_HEAD + i * ROW + 16} text-anchor="end" class={v.ref ? 'jmt-mem-ref' : 'jmt-mem-val'}>{v.ref ? '•' : v.value}</text>
					</g>
				))}
			</g>
		))}
		{pool && (
			<g>
				<rect x={pool.x} y={pool.y} width={pool.w} height={pool.h} rx="10" class="jmt-mem-pool" />
				<text x={pool.x + 10} y={pool.y + 19} class="jmt-mem-muted">String Constant Pool</text>
			</g>
		)}
		{[...objBoxes.values()].map((o) => (
			<g class={`jmt-mem-obj ${o.gc ? 'is-gc' : ''} ${o.highlight ? 'is-hl' : ''}`}>
				<rect x={o.x} y={o.y} width={o.w} height={o.h} rx="8" class="jmt-mem-box" />
				<text x={o.x + 10} y={o.y + 19} class="jmt-mem-head">{o.label}</text>
				{o.gc && <text x={o.x + o.w - 10} y={o.y + 19} text-anchor="end" class="jmt-mem-muted">unreachable</text>}
				{(o.fields ?? []).map((fd, i) => (
					<g class={fd.highlight ? 'is-hl' : ''}>
						<text x={o.x + 12} y={o.y + OBJ_HEAD + i * OBJ_ROW + 15} class="jmt-mem-name">{fd.type ? `${fd.type} ` : ''}{fd.name}</text>
						<text x={o.x + o.w - 14} y={o.y + OBJ_HEAD + i * OBJ_ROW + 15} text-anchor="end" class={fd.ref ? 'jmt-mem-ref' : 'jmt-mem-val'}>{fd.ref ? '•' : fd.value}</text>
					</g>
				))}
			</g>
		))}
		{arrows.map((a) => <path d={a.d} class={`jmt-mem-arrow ${a.gc ? 'is-gc' : ''}`} marker-end={`url(#${markerId})`} />)}
	</svg>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
