---
/**
 * Interactive IEEE 754 lab (Preact island). Its arithmetic lives in src/lib/ieee754.mjs and is checked against the
 * JVM by `npm run check:floatlab`.
 * <FloatLab initial="0.7" format="float" />
 */
import FloatLabIsland from './islands/FloatLabIsland';

interface Props {
	initial?: string;
	format?: 'float' | 'double';
}
const { initial = '0.7', format = 'float' } = Astro.props;
---

<figure class="jmt-fl-wrap">
	<FloatLabIsland client:visible initial={initial} initialFormat={format} />
	<noscript><p class="jmt-muted">The IEEE 754 lab needs JavaScript. The FloatAnatomy example shows the same breakdown.</p></noscript>
	<figcaption class="jmt-example__caption">
		<span class="jmt-verified">✓ Every readout is checked against the JVM's own answers on each build</span>
	</figcaption>
</figure>
