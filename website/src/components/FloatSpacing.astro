---
/**
 * Build-time SVG: every positive value of a toy floating-point format (2 fraction bits) on a linear number line.
 * Shows the key idea of floating point: in each power-of-two range there are the same number of values, so the gap
 * between neighbours doubles from one range to the next.
 */
interface Props {
	caption?: string;
}
const { caption } = Astro.props;
const FRACTION_BITS = 2;
const MIN_EXP = -1;
const MAX_EXP = 3;
const MAX = 16;
const W = 720;
const LEFT = 20;
const RIGHT = 700;
const AXIS_Y = 50;
const x = (v: number) => LEFT + (v / MAX) * (RIGHT - LEFT);
const binades = [];
for (let e = MIN_EXP; e <= MAX_EXP; e++) {
	const values = [];
	for (let m = 0; m < 1 << FRACTION_BITS; m++) values.push((1 + m / (1 << FRACTION_BITS)) * 2 ** e);
	binades.push({ e, from: 2 ** e, to: 2 ** (e + 1), gap: 2 ** e / (1 << FRACTION_BITS), values });
}
const fmt = (n: number) => String(n);
---

<figure class="jmt-spacing">
	<svg viewBox={`0 0 ${W} 150`} role="img" aria-labelledby="jmt-spacing-title">
		<title id="jmt-spacing-title">
			Values of a tiny floating-point format on a number line from 0 to 16: four values in every power-of-two range,
			so the gap doubles from 0.125 near 0.5 to 2 near 16.
		</title>
		<line class="jmt-spacing__axis" x1={LEFT} y1={AXIS_Y} x2={RIGHT} y2={AXIS_Y} />
		{[0, 1, 2, 4, 8, 16].map((v) => (
			<text class="jmt-spacing__label" x={x(v)} y={AXIS_Y + 42} text-anchor="middle">{fmt(v)}</text>
		))}
		{binades.map((b, i) => (
			<g class={`jmt-spacing__binade jmt-spacing__binade--${i % 2}`}>
				{b.values.map((v) => (
					<line class="jmt-spacing__tick" x1={x(v)} y1={AXIS_Y - 16} x2={x(v)} y2={AXIS_Y + 16} />
				))}
				<path class="jmt-spacing__brace" d={`M ${x(b.from)} ${AXIS_Y + 24} V ${AXIS_Y + 28} H ${x(b.to)} V ${AXIS_Y + 24}`} />
				{b.e >= 1 && (
					<text class="jmt-spacing__gap" x={(x(b.from) + x(b.to)) / 2} y={AXIS_Y - 24} text-anchor="middle">gap {fmt(b.gap)}</text>
				)}
			</g>
		))}
		<line class="jmt-spacing__tick jmt-spacing__tick--zero" x1={x(0)} y1={AXIS_Y - 16} x2={x(0)} y2={AXIS_Y + 16} />
		<text class="jmt-spacing__gap" x={x(0.75)} y={AXIS_Y - 24} text-anchor="middle">gap 0.125 → 0.25</text>
		<text class="jmt-spacing__note" x={LEFT} y={AXIS_Y + 80}>Each range [2ⁿ, 2ⁿ⁺¹) holds the same 4 values, so the gap doubles each time.</text>
	</svg>
	{caption && <figcaption class="jmt-example__caption"><span class="jmt-muted">{caption}</span></figcaption>}
</figure>
