---
/**
 * Step-through container for walkthroughs (memory, call stack, GC…). Children are <Step title="…"> elements.
 * Without JavaScript every step is visible in order (progressive enhancement).
 */
interface Props {
	title?: string;
}
const { title } = Astro.props;
---

<jmt-stepper class="jmt-stepper">
	{title && <p class="jmt-stepper__title">{title}</p>}
	<div class="jmt-stepper__steps"><slot /></div>
	<div class="jmt-stepper__bar" hidden>
		<button type="button" data-prev aria-label="Previous step">← Prev</button>
		<span class="jmt-small" data-counter aria-live="polite"></span>
		<button type="button" data-next aria-label="Next step">Next →</button>
	</div>
</jmt-stepper>

<script>
	class JmtStepper extends HTMLElement {
		#i = 0;
		connectedCallback() {
			const steps = [...this.querySelectorAll<HTMLElement>(':scope > .jmt-stepper__steps > .jmt-step')];
			if (steps.length < 2) return;
			const bar = this.querySelector<HTMLElement>('.jmt-stepper__bar')!;
			const counter = this.querySelector<HTMLElement>('[data-counter]')!;
			const prev = this.querySelector<HTMLButtonElement>('[data-prev]')!;
			const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
			const show = (i: number) => {
				this.#i = Math.max(0, Math.min(steps.length - 1, i));
				steps.forEach((s, k) => (s.hidden = k !== this.#i));
				counter.textContent = `Step ${this.#i + 1} of ${steps.length}`;
				prev.disabled = this.#i === 0;
				next.disabled = this.#i === steps.length - 1;
			};
			prev.addEventListener('click', () => show(this.#i - 1));
			next.addEventListener('click', () => show(this.#i + 1));
			this.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight') show(this.#i + 1);
				if (e.key === 'ArrowLeft') show(this.#i - 1);
			});
			bar.hidden = false;
			this.classList.add('is-enhanced');
			show(0);
		}
	}
	if (!customElements.get('jmt-stepper')) customElements.define('jmt-stepper', JmtStepper);
</script>
