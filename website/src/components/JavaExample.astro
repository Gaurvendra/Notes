---
/**
 * Shows code from java-track (compiled & tested), optionally one snippet region, optionally with its verified output.
 * <JavaExample file="examples/src/main/java/track/template/HelloTrack.java" snippet="greeting" output />
 */
import { Code } from '@astrojs/starlight/components';
import { readJavaTrackFile, extractSnippet, stripMarkers, goldenPathFor, testPathFor } from '../lib/java-source.mjs';

interface Props {
	file: string;
	snippet?: string;
	title?: string;
	output?: boolean;
	mark?: string | number | (string | number)[];
	ins?: string | number | (string | number)[];
	del?: string | number | (string | number)[];
}
const { file, snippet, title, output = false, mark, ins, del } = Astro.props;
const source = readJavaTrackFile(file);
const code = snippet ? extractSnippet(source, snippet, file) : stripMarkers(source);
const fileName = file.split('/').pop();
const out = output ? readJavaTrackFile(goldenPathFor(file)).replace(/\s+$/, '') : undefined;
const testFile = testPathFor(file);
---

<figure class="jmt-example">
	<Code code={code} lang="java" title={title ?? fileName} mark={mark} ins={ins} del={del} />
	{out !== undefined && <Code code={out} lang="text" title="Output" frame="terminal" />}
	<figcaption class="jmt-example__caption">
		<span class="jmt-verified">✓ Compiled &amp; tested on Java 25</span>
		<span class="jmt-muted" title={`java-track/${testFile}`}>java-track/{file}</span>
	</figcaption>
</figure>
