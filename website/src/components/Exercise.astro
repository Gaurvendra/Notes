---
/**
 * A practice exercise backed by java-track: stub in practice/, reference solution in solutions/, tests shared.
 * <Exercise id="template/DigitSum" difficulty="warmup" title="Sum of digits" hints={["…"]}> statement </Exercise>
 * `needs` names Java features the exercise uses that a beginner may not have met yet (Markdown, links allowed).
 */
import { Code } from '@astrojs/starlight/components';
import { readJavaTrackFile, stripMarkers } from '../lib/java-source.mjs';
import { mdInline } from '../lib/markdown.mjs';

interface Props {
	id: string; // "<package path under track/>/<ClassName>", e.g. "template/DigitSum"
	difficulty: 'warmup' | 'core' | 'challenge';
	title: string;
	hints?: string[];
	needs?: string;
}
const { id, difficulty, title, hints = [], needs } = Astro.props;
const LEVELS = { warmup: '🟢 Warm-up', core: '🟡 Core', challenge: '🔴 Challenge' } as const;
const starterPath = `practice/src/main/java/track/${id}.java`;
const testPath = `practice/src/test/java/track/${id}Test.java`;
const solutionPath = `solutions/src/main/java/track/${id}.java`;
const starter = stripMarkers(readJavaTrackFile(starterPath));
const tests = stripMarkers(readJavaTrackFile(testPath));
const solution = stripMarkers(readJavaTrackFile(solutionPath));
const testClass = id.split('/').pop() + 'Test';
---

<section class={`jmt-exercise jmt-exercise--${difficulty}`}>
	<header class="jmt-exercise__header">
		<span class="jmt-chip">{LEVELS[difficulty]}</span>
		<h3 class="jmt-exercise__title">{title}</h3>
	</header>
	<div class="jmt-exercise__statement"><slot /></div>
	{needs && <p class="jmt-small jmt-exercise__needs"><strong>Uses:</strong> <span set:html={mdInline(needs)} /></p>}
	<p class="jmt-small">Edit <code>java-track/{starterPath}</code>, then run its tests until they pass:</p>
	<Code code={`cd java-track\nmvn -pl practice -am test -Dpractice -Dtest=${testClass}`} lang="sh" frame="terminal" title="Run the tests" />
	<details>
		<summary>Starter code</summary>
		<Code code={starter} lang="java" title={starterPath.split('/').pop()} />
	</details>
	<details>
		<summary>Tests your solution must pass</summary>
		<Code code={tests} lang="java" title={testPath.split('/').pop()} />
	</details>
	{hints.map((h, i) => (
		<details>
			<summary>Hint {i + 1}</summary>
			<p set:html={mdInline(h)} />
		</details>
	))}
	<details class="jmt-exercise__solution">
		<summary>Reference solution</summary>
		<Code code={solution} lang="java" title={`${solutionPath.split('/').pop()} (solution)`} />
	</details>
</section>
