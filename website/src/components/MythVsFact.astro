---
/**
 * Myth vs fact, used for every correction from the notes audit. Neutral wording: "Common belief" → "Precise truth".
 * Usage: <MythVsFact myth="The default value of a boolean field is true." audit="4.11"> Fact body… </MythVsFact>
 */
interface Props {
	myth: string;
	audit?: string;
}
const { myth, audit } = Astro.props;
---

<div class="jmt-myth">
	<div class="jmt-myth__belief">
		<p class="jmt-myth__label">🧱 Common belief</p>
		<p>{myth}</p>
	</div>
	<div class="jmt-myth__fact">
		<p class="jmt-myth__label">✅ Precise truth{audit && <span class="jmt-muted jmt-small"> · audit {audit}</span>}</p>
		<slot />
	</div>
</div>
