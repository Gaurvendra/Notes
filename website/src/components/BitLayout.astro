---
/**
 * Bit-level layout, e.g. IEEE-754 or two's complement.
 * <BitLayout groups={[{ bits: '0', label: 'sign' }, { bits: '10000001', label: 'exponent (129)' }, { bits: '00001000000000000000000', label: 'mantissa' }]} />
 * <BitLayout groups={[{ bits: '1011', label: '-5 in 4-bit two\'s complement' }]} weights signed />
 */
interface Group {
	bits: string;
	label?: string;
	kind?: 'sign' | 'exponent' | 'mantissa' | 'value';
}
interface Props {
	groups: Group[];
	weights?: boolean; // show positional weights above each bit (2^n)
	signed?: boolean; // with weights: the MSB weight is negative (two's complement)
	caption?: string;
}
const { groups, weights = false, signed = false, caption } = Astro.props;
for (const g of groups) if (!/^[01]+$/.test(g.bits)) throw new Error(`BitLayout: invalid bits "${g.bits}"`);
const total = groups.reduce((n, g) => n + g.bits.length, 0);
const kinds = ['sign', 'exponent', 'mantissa'];
let position = total;
const cells = groups.map((g, gi) => ({
	...g,
	kind: g.kind ?? (groups.length === 3 ? kinds[gi] : 'value'),
	bits: [...g.bits].map((b) => {
		position--;
		const w = position === total - 1 && signed ? `-2${sup(position)}` : `2${sup(position)}`;
		return { b, w };
	}),
}));
function sup(n: number) {
	const map: Record<string, string> = { '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
	return String(n).split('').map((c) => map[c]).join('');
}
const aria = caption ?? groups.map((g) => `${g.label ?? 'bits'}: ${g.bits}`).join('; ');
---

<figure class={`jmt-bits ${total > 20 ? "is-compact" : ""}`} role="img" aria-label={aria}>
	<div class="jmt-bits__row">
		{cells.map((g) => (
			<div class={`jmt-bits__group jmt-bits__group--${g.kind}`}>
				<div class="jmt-bits__cells">
					{g.bits.map((c) => (
						<span class="jmt-bits__cell">
							{weights && <span class="jmt-bits__w">{c.w}</span>}
							<span class="jmt-bits__b">{c.b}</span>
						</span>
					))}
				</div>
				{g.label && <div class="jmt-bits__label">{g.label}</div>}
			</div>
		))}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>
