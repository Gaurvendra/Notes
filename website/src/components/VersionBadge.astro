---
/**
 * Java version badge. Examples: <VersionBadge since={21} /> · <VersionBadge preview={27} jep={532} /> ·
 * <VersionBadge removed={14} /> · <VersionBadge deprecated={9} />
 */
interface Props {
	since?: number;
	preview?: number;
	incubator?: number;
	deprecated?: number;
	removed?: number;
	jep?: number;
}
const { since, preview, incubator, deprecated, removed, jep } = Astro.props;
let text: string;
let variant: string;
if (removed) [text, variant] = [`Removed in Java ${removed}`, 'bad'];
else if (deprecated) [text, variant] = [`Deprecated since Java ${deprecated}`, 'warn'];
else if (preview) [text, variant] = [`Preview in Java ${preview}`, 'purple'];
else if (incubator) [text, variant] = [`Incubator in Java ${incubator}`, 'purple'];
else if (since) [text, variant] = [`Java ${since}+`, 'ok'];
else throw new Error('VersionBadge needs one of since/preview/incubator/deprecated/removed');
const jepText = jep ? ` · JEP ${jep}` : '';
---

<span class={`jmt-badge jmt-badge--${variant}`}>{text}{jepText}</span>
