---
import { clientGraph, loadCurriculum } from '../lib/curriculum-core.mjs';

interface Props {
	id: string;
}
const lesson = loadCurriculum().byId.get(Astro.props.id)!;
const graph = clientGraph();
---

<section class="jmt-progress" data-jmt-progress data-lesson={Astro.props.id} data-pagefind-ignore aria-label="Your progress">
	<button type="button" class="jmt-complete" aria-pressed="false" data-complete>
		<span class="jmt-complete__box" aria-hidden="true"></span>
		<span data-label>Mark “{lesson.label}” as complete</span>
	</button>
	<div class="jmt-nextup" data-nextup hidden>
		<h2 class="jmt-nextup__title">Next up for you</h2>
		<ul data-nextup-list></ul>
		<p class="jmt-muted jmt-small">Based on the lessons you've marked complete in this browser. See the <a href="/roadmap/">roadmap</a>.</p>
	</div>
</section>
<script type="application/json" data-jmt-graph set:html={JSON.stringify(graph)} />

<script>
	import { getCompleted, setCompleted, unlocked, readGraph, PROGRESS_EVENT } from '../lib/progress';

	function render(section: HTMLElement) {
		const id = section.dataset.lesson!;
		const done = getCompleted();
		const button = section.querySelector<HTMLButtonElement>('[data-complete]')!;
		const isDone = done.has(id);
		button.setAttribute('aria-pressed', String(isDone));
		button.classList.toggle('is-done', isDone);
		const graph = readGraph();
		const box = section.querySelector<HTMLElement>('[data-nextup]')!;
		const list = section.querySelector<HTMLUListElement>('[data-nextup-list]')!;
		if (!graph || !isDone) {
			box.hidden = true;
			return;
		}
		const next = unlocked(graph.lessons, done).slice(0, 4);
		list.replaceChildren(
			...next.map((l) => {
				const li = document.createElement('li');
				const a = document.createElement('a');
				a.href = l.url;
				a.textContent = l.label;
				li.append(a);
				return li;
			}),
		);
		box.hidden = next.length === 0;
	}

	for (const section of document.querySelectorAll<HTMLElement>('[data-jmt-progress]')) {
		section.querySelector('[data-complete]')!.addEventListener('click', () => {
			const id = section.dataset.lesson!;
			setCompleted(id, !getCompleted().has(id));
		});
		render(section);
		window.addEventListener(PROGRESS_EVENT, () => render(section));
	}
</script>
