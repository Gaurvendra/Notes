---
/** Semantic callouts used by every lesson. */
const TYPES = {
	tldr: { icon: '📌', label: 'TL;DR' },
	myth: { icon: '🧱', label: 'Common belief' },
	fact: { icon: '✅', label: 'Precise truth' },
	doubt: { icon: '🤔', label: 'Doubt cleared' },
	senior: { icon: '🧭', label: 'Senior lens' },
	pitfall: { icon: '⚠️', label: 'Pitfall' },
	tip: { icon: '💡', label: 'Tip' },
	version: { icon: '🆕', label: 'Modern Java' },
	'deep-dive': { icon: '🔬', label: 'Under the hood' },
} as const;

interface Props {
	type: keyof typeof TYPES;
	title?: string;
}
const { type, title } = Astro.props;
const t = TYPES[type];
if (!t) throw new Error(`Callout: unknown type "${type}"`);
---

<aside class={`jmt-callout jmt-callout--${type}`} aria-label={title ?? t.label}>
	<p class="jmt-callout__title"><span aria-hidden="true">{t.icon}</span> {title ?? t.label}</p>
	<div class="jmt-callout__body"><slot /></div>
</aside>
