---
/** Flashcards from lesson data (default: current lesson). */
import { getEntry } from 'astro:content';
import FlashcardsIsland from './islands/FlashcardsIsland';
import { md } from '../lib/markdown.mjs';
import { lessonIdFromEntry } from '../lib/curriculum-core.mjs';

interface Props {
	lesson?: string;
}
const lesson = Astro.props.lesson ?? lessonIdFromEntry(Astro.locals.starlightRoute.entry.id);
const entry = lesson ? await getEntry('lessonData', lesson) : undefined;
if (!entry || entry.data.flashcards.length === 0) throw new Error(`Flashcards: no flashcards for "${lesson}"`);
const cards = entry.data.flashcards.map((c) => ({ frontHtml: md(c.front), backHtml: md(c.back) }));
---

<FlashcardsIsland client:visible cards={cards} deck={lesson!} />
