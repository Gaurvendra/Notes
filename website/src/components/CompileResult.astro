---
/**
 * Shows code that does (or deliberately does not) compile, with the exact javac result verified by
 * LessonCompileResultsTest. Case folder: java-track/examples/src/test/resources/compile-errors/<case>/
 * <CompileResult case="template/missing-return-type" />
 */
import { Code } from '@astrojs/starlight/components';
import { readCompileCase } from '../lib/java-source.mjs';

interface Props {
	case: string;
	title?: string;
}
const { case: caseId, title } = Astro.props;
const result = readCompileCase(caseId);
const message = result.compiles ? '✓ Compiles without errors' : `error: ${result.expected}`;
---

<figure class={`jmt-compile ${result.compiles ? 'is-ok' : 'is-error'}`}>
	{result.files.map((f, i) => <Code code={f.code} lang="java" title={i === 0 && title ? title : f.name} />)}
	<Code code={`$ javac ${result.files.map((f) => f.name).join(' ')}\n${message}`} lang="text" title="javac" frame="terminal" />
	<figcaption class="jmt-example__caption">
		<span class="jmt-verified">✓ Verified with javac 25</span>
	</figcaption>
</figure>
