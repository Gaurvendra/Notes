---
/** "Continue learning": the next unlocked lessons for this browser's progress (or the first lessons for newcomers). */
import { clientGraph, loadCurriculum } from '../lib/curriculum-core.mjs';

// Server-rendered default (no progress yet): lessons without prerequisites. The script updates it from progress.
const starters = loadCurriculum().lessons.filter((l) => l.prereqs.length === 0);
---

<div class="jmt-continue" data-jmt-continue>
	<p class="jmt-continue__title" data-title>Start with</p>
	<ul data-list>
		{starters.map((l) => <li><a href={l.url}>{l.label}</a><span class="jmt-muted jmt-small"> · T{l.tier}</span></li>)}
	</ul>
</div>
<script type="application/json" data-jmt-graph set:html={JSON.stringify(clientGraph())} />

<script>
	import { getCompleted, unlocked, readGraph, PROGRESS_EVENT } from '../lib/progress';

	for (const root of document.querySelectorAll<HTMLElement>('[data-jmt-continue]')) {
		const graph = readGraph();
		if (!graph) continue;
		const paint = () => {
			const done = getCompleted();
			const next = unlocked(graph.lessons, done).slice(0, 5);
			root.querySelector('[data-title]')!.textContent = done.size ? 'Continue with' : 'Start with';
			root.querySelector('[data-list]')!.replaceChildren(
				...next.map((l) => {
					const li = document.createElement('li');
					const a = document.createElement('a');
					a.href = l.url;
					a.textContent = l.label;
					const t = document.createElement('span');
					t.className = 'jmt-muted jmt-small';
					t.textContent = ` · T${l.tier}`;
					li.append(a, t);
					return li;
				}),
			);
		};
		paint();
		window.addEventListener(PROGRESS_EVENT, paint);
	}
</script>
